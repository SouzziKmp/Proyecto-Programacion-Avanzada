@model Proyecto.Data.Entities.ApplicationUser

@{
    ViewBag.Title = "Detalles del usuario";
}

<h2>Detalles del usuario</h2>

<dl class="row">
    <dt class="col-sm-3">
        Nombre
    </dt>

    <dd class="col-sm-9">
        @Model.Nombre @Model.Apellidos
    </dd>

    <dt class="col-sm-3">
        Correo
    </dt>

    <dd class="col-sm-9">
        @Model.Email
    </dd>

    <dt class="col-sm-3">
        Cédula
    </dt>

    <dd class="col-sm-9">
        @Model.Cedula
    </dd>

    <dt class="col-sm-3">
        Teléfono
    </dt>

    <dd class="col-sm-9">
        @Model.Telefono
    </dd>

    <dt class="col-sm-3">
        Fecha de registro
    </dt>

    <dd class="col-sm-9">
        @Model.FechaRegistro
    </dd>

    <dt class="col-sm-3">
        Último login
    </dt>

    <dd class="col-sm-9">
        @Model.UltimoLogin
    </dd>

    <dt class="col-sm-3">
        Estado
    </dt>

    <dd class="col-sm-9">
        @(Model.Activo ? "Activo" : "Inactivo")
    </dd>
</dl>

@Html.ActionLink(
    "Editar",
    "Edit",
    new { id = Model.Id },
    new { @class = "btn btn-warning" }
)

@Html.ActionLink(
    "Volver",
    "Index",
    null,
    new { @class = "btn btn-secondary" }
)