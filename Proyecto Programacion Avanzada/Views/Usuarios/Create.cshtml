@model Proyecto_Programacion_Avanzada.Controllers.UsuarioCreateViewModel

@{
    ViewBag.Title = "Crear usuario";
}

<h2>Crear usuario</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(
        true,
        "",
        new { @class = "text-danger" }
    )

    <div class="mb-3">
        @Html.LabelFor(m => m.Nombre)
        @Html.TextBoxFor(
            m => m.Nombre,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Apellidos)
        @Html.TextBoxFor(
            m => m.Apellidos,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Cedula)
        @Html.TextBoxFor(
            m => m.Cedula,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Telefono)
        @Html.TextBoxFor(
            m => m.Telefono,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(
            m => m.Email,
            new
            {
                @class = "form-control",
                type = "email"
            }
        )
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Password)
        @Html.PasswordFor(
            m => m.Password,
            new { @class = "form-control" }
        )
    </div>

    <div class="mb-3">
        <label>Rol</label>

        <select name="Rol" class="form-control">
            <option value="Asociado">
                Asociado
            </option>

            <option value="Administrador">
                Administrador
            </option>
        </select>
    </div>

    <button class="btn btn-success" type="submit">
        Crear
    </button>

    @Html.ActionLink(
        "Cancelar",
        "Index",
        null,
        new { @class = "btn btn-secondary" }
    )
}