@model Proyecto.Data.Entities.Concierto

@{
    ViewBag.Title = "Editar Concierto";
}

<h2>Editar Concierto</h2>

@using (Html.BeginForm(
    "Edit",
    "Conciertos",
    FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(model => model.ConciertoId)

    <div class="text-center" style="margin-bottom:20px;">

        <img src="@Url.Action("Concierto", "Imagen", new { id = Model.ConciertoId })"
             style="max-width:350px;
                max-height:250px;
                border-radius:8px;
                border:1px solid #ccc;" />

    </div>

    <div class="form-horizontal">

        <hr />

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model.Titulo)
            @Html.TextBoxFor(model => model.Titulo, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Titulo, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Descripcion)
            @Html.TextAreaFor(model => model.Descripcion, 5, 50, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.Label("Fecha del Evento")
            @Html.TextBoxFor(model => model.FechaEvento,
                "{0:yyyy-MM-ddTHH:mm}",
                new
                {
                    @class = "form-control",
                    type = "datetime-local"
                })
            @Html.ValidationMessageFor(model => model.FechaEvento, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.Label("Categoría")
            @Html.DropDownListFor(model => model.CategoriaId,
                (SelectList)ViewBag.Categorias,
                "-- Seleccione una categoría --",
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.Label("Lugar")
            @Html.DropDownListFor(model => model.LugarId,
                (SelectList)ViewBag.Lugares,
                "-- Seleccione un lugar --",
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.Label("Estado")
            @Html.DropDownListFor(model => model.Estado,
                new SelectList(new[]
                {
                    new { Value = 1, Text = "Activo" },
                    new { Value = 0, Text = "Inactivo" }
                }, "Value", "Text", Model.Estado),
                new { @class = "form-control" })
        </div>
        <div class="form-group">

            @Html.Label("Cambiar imagen")

            <input type="file"
                   name="imagen"
                   class="form-control"
                   accept="image/*" />

        </div>
        <br />

        <button type="submit" class="btn btn-warning">
            Actualizar
        </button>

        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })

    </div>
}