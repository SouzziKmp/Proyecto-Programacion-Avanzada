@{
    ViewBag.Title = "Moderación de reseñas";
}

<h2 class="mb-4">Moderación de reseñas</h2>

<div id="moderacion-error" class="alert alert-danger d-none"></div>
<div id="moderacion-vacio" class="alert alert-info d-none">No hay reseñas pendientes.</div>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Concierto</th>
            <th>Usuario</th>
            <th>Calificación</th>
            <th>Comentario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody id="cuerpo-resenas"></tbody>
</table>

<div class="modal fade" id="confirmarModeracionModal" tabindex="-1" aria-labelledby="confirmarModeracionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="confirmarModeracionLabel" class="modal-title">Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p id="confirmarModeracionMensaje">¿Confirmas esta acción?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmarModeracionBoton" class="btn btn-primary">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var confirmarModeracionModal;
        var accionPendiente = null;

        function cargarResenas() {
            fetch("/api/resenas/pendientes", { method: "GET", credentials: "same-origin" })
                .then(function (respuesta) {
                    if (!respuesta.ok) throw new Error("No se pudieron cargar las reseñas.");
                    return respuesta.json();
                })
                .then(function (resenas) {
                    var cuerpo = document.getElementById("cuerpo-resenas");
                    cuerpo.innerHTML = "";

                    var vacio = document.getElementById("moderacion-vacio");
                    if (resenas.length === 0) {
                        vacio.classList.remove("d-none");
                        return;
                    }
                    vacio.classList.add("d-none");

                    resenas.forEach(function (r) {
                        var fila = document.createElement("tr");
                        fila.id = "resena-" + r.ResenaId;

                        var tdConcierto = document.createElement("td");
                        tdConcierto.textContent = r.Concierto;

                        var tdUsuario = document.createElement("td");
                        tdUsuario.textContent = r.Usuario;

                        var tdCalificacion = document.createElement("td");
                        tdCalificacion.textContent = r.Calificacion + " / 5";

                        var tdComentario = document.createElement("td");
                        tdComentario.textContent = r.Comentario;

                        var tdAcciones = document.createElement("td");

                        var btnAprobar = document.createElement("button");
                        btnAprobar.className = "btn btn-success btn-sm me-1";
                        btnAprobar.textContent = "Aprobar";
                        btnAprobar.onclick = function () {
                            pedirConfirmacion(r.ResenaId, true, r.Comentario);
                        };

                        var btnRechazar = document.createElement("button");
                        btnRechazar.className = "btn btn-danger btn-sm";
                        btnRechazar.textContent = "Rechazar";
                        btnRechazar.onclick = function () {
                            pedirConfirmacion(r.ResenaId, false, r.Comentario);
                        };

                        tdAcciones.appendChild(btnAprobar);
                        tdAcciones.appendChild(btnRechazar);

                        fila.appendChild(tdConcierto);
                        fila.appendChild(tdUsuario);
                        fila.appendChild(tdCalificacion);
                        fila.appendChild(tdComentario);
                        fila.appendChild(tdAcciones);

                        cuerpo.appendChild(fila);
                    });
                })
                .catch(function (error) {
                    var caja = document.getElementById("moderacion-error");
                    caja.textContent = error.message;
                    caja.classList.remove("d-none");
                });
        }

        function pedirConfirmacion(id, aprobar, comentario) {
            accionPendiente = { id: id, aprobar: aprobar };

            var verbo = aprobar ? "aprobar" : "rechazar";
            document.getElementById("confirmarModeracionMensaje").textContent =
                "¿Seguro que deseas " + verbo + " esta reseña? \"" + comentario + "\"";

            var boton = document.getElementById("confirmarModeracionBoton");
            boton.className = "btn btn-sm " + (aprobar ? "btn-success" : "btn-danger");
            boton.textContent = aprobar ? "Sí, aprobar" : "Sí, rechazar";

            confirmarModeracionModal.show();
        }

        function moderar(id, aprobar) {
            fetch("/api/resenas/" + id + "/moderar", {
                method: "PUT",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ Aprobar: aprobar })
            })
                .then(function (respuesta) {
                    if (!respuesta.ok) throw new Error("No se pudo moderar la reseña.");
                    var fila = document.getElementById("resena-" + id);
                    if (fila) fila.remove();
                })
                .catch(function (error) {
                    var caja = document.getElementById("moderacion-error");
                    caja.textContent = error.message;
                    caja.classList.remove("d-none");
                });
        }

        document.addEventListener("DOMContentLoaded", function () {
            confirmarModeracionModal = new bootstrap.Modal(document.getElementById("confirmarModeracionModal"));

            document.getElementById("confirmarModeracionBoton").addEventListener("click", function () {
                if (accionPendiente) {
                    moderar(accionPendiente.id, accionPendiente.aprobar);
                    accionPendiente = null;
                }
                confirmarModeracionModal.hide();
            });

            cargarResenas();
        });
    </script>
}
