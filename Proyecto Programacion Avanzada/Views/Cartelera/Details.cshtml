@using System.Linq
@model Proyecto.Data.Entities.Concierto

@{
    ViewBag.Title = Model.Titulo;
}

<div class="row">
    <div class="col-md-7">
        <img src="@Url.Action("Imagen", "Cartelera", new { id = Model.ConciertoId })"
             class="img-fluid rounded mb-3"
             alt="@Model.Titulo"
             style="max-height: 420px; object-fit: cover; width: 100%;" />
    </div>

    <div class="col-md-5">
        <h2>@Model.Titulo</h2>

        <p class="text-muted">
            @Model.FechaEvento.ToString("dd/MM/yyyy hh:mm tt")
        </p>

        <p>
            <strong>Lugar:</strong> @Model.Lugar.Nombre
        </p>

        <p>
            <strong>Categoría:</strong> @Model.Categoria.Nombre
        </p>

        <p>
            @Model.Descripcion
        </p>

        <hr />

        <h4>Entradas disponibles</h4>
        <div id="carrito-mensaje" class="alert d-none"></div>

        @if (!Model.TiposEntrada.Any())
        {
            <div class="alert alert-warning">

            </div>
        }
        else
        {
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Precio</th>
                        <th>Disponibles</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tipo in Model.TiposEntrada)
                    {
                        <tr>
                            <td>@tipo.Nombre</td>
                            <td>₡@tipo.Precio.ToString("N2")</td>
                            <td>@tipo.Disponibles</td>
                            <td>
                                if (tipo.Disponibles > 0)
                                {
                                <div class="input-group input-group-sm">
                                    <input type="number"
                                           id="cantidad-@tipo.TipoEntradaId"
                                           value="1"
                                           min="1"
                                           max="@tipo.Disponibles"
                                           class="form-control" />

                                    <button type="button"
                                            class="btn btn-primary"
                                            onclick="agregarEntrada(@tipo.TipoEntradaId)">
                                        Agregar
                                    </button>
                                </div>
                                }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="alert alert-info">

            </div>
        }

        @Html.ActionLink("Volver a cartelera", "Index", "Cartelera", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
@section scripts {
    <script>
        function agregarEntrada(tipoEntradaId) {
            var cantidad = parseInt(document.getElementById("cantidad-" + tipoEntradaId).value, 10);

            fetch("/api/entradas/agregar", {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ TipoEntradaId: tipoEntradaId, Cantidad: cantidad })
            })
                .then(function (respuesta) {
                    return respuesta.json().then(function (datos) {
                        return { ok: respuesta.ok, datos: datos };
                    });
                })
                .then(function (resultado) {
                    var caja = document.getElementById("carrito-mensaje");
                    caja.classList.remove("d-none", "alert-success", "alert-danger");

                    if (resultado.ok) {
                        caja.classList.add("alert-success");
                        caja.textContent = resultado.datos.mensaje || "Entrada agregada al carrito.";
                    } else {
                        caja.classList.add("alert-danger");
                        caja.textContent = resultado.datos || "No se pudo agregar la entrada.";
                    }
                })
                .catch(function () {
                    var caja = document.getElementById("carrito-mensaje");
                    caja.classList.remove("d-none");
                    caja.classList.add("alert-danger");
                    caja.textContent = "Ocurrió un error al conectar con el servidor.";
                });
        }
    </script>
}