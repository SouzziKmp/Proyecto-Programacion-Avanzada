@model IEnumerable<Proyecto.Data.Entities.Concierto>

@{
    ViewBag.Title = "Inicio";
}

<div class="p-5 mb-4 bg-dark text-white rounded">
    <h1 class="display-5 fw-bold">FideTickets</h1>
    <p class="lead">
        Compra tus entradas para los mejores conciertos, talleres y charlas.
        Encuentra el evento, elige tu tipo de entrada y asegura tu lugar.
    </p>
    @Html.ActionLink("Ver cartelera", "Index", "Cartelera", null, new { @class = "btn btn-primary btn-lg" })
</div>

<h2 class="mb-4">Próximos eventos</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay eventos publicados.
    </div>
}
else
{
    <div class="row g-4 mb-4">
        @foreach (var concierto in Model)
        {
            var precioDesde = concierto.TiposEntrada.Any()
                ? concierto.TiposEntrada.Min(t => t.Precio)
                : 0;

            <div class="col-md-4">
                <div class="card h-100">
                    <img src="@Url.Action("Imagen", "Cartelera", new { id = concierto.ConciertoId })"
                         class="card-img-top"
                         alt="@concierto.Titulo"
                         style="height: 220px; object-fit: cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@concierto.Titulo</h5>

                        <p class="card-text text-muted mb-1">
                            @concierto.FechaEvento.ToString("dd/MM/yyyy hh:mm tt")
                        </p>

                        <p class="card-text mb-1">
                            @concierto.Lugar.Nombre
                        </p>

                        <p class="card-text">
                            <strong>Desde:</strong> ₡@precioDesde.ToString("N2")
                        </p>
                    </div>

                    <div class="card-footer bg-white">
                        @Html.ActionLink(
                            "Ver detalle",
                            "Details",
                            "Cartelera",
                            new { id = concierto.ConciertoId },
                            new { @class = "btn btn-primary w-100" }
                        )
                    </div>
                </div>
            </div>
        }
    </div>

    <p>@Html.ActionLink("Ver toda la cartelera »", "Index", "Cartelera")</p>
}
